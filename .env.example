# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env      # then edit .env

# --- LLM (agent reasoning layer; uses the OpenAI Python SDK) ---------------
# Required: an OpenAI-style API key ("sk-...").
OPENAI_API_KEY=sk-...

# Optional: base URL of an OpenAI-COMPATIBLE endpoint. Leave unset/blank to use
# the official OpenAI API. For Dartmouth's hosted endpoint use:
# OPENAI_BASE_URL=https://chat.dartmouth.edu/api

# Which model to use. Must be one the endpoint exposes. Proxies often namespace
# names (e.g. "openai.gpt-4o", "anthropic.claude-sonnet-4-6"). Default: gpt-4o.
AGENT_MODEL=gpt-4o

# --- Data -----------------------------------------------------------------
# Optional override of the subset path the agent loads.
# HNOCA_DATA_PATH=data/hnoca_dt_subset.h5ad
