# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env       # then edit .env

# ----------------------------------------------------------------------------
# LLM backbone — Nous Portal (Hermes-4) by default
# ----------------------------------------------------------------------------
# Required: an OpenAI-style API key. For Nous Portal sign up at
# https://portal.nousresearch.com — same SDK works.
OPENAI_API_KEY=sk-...

# Base URL of an OpenAI-compatible endpoint. Default = Nous Portal.
# Alternatives:
#   https://api.openai.com/v1                 (OpenAI proper)
#   https://openrouter.ai/api/v1              (OpenRouter)
#   https://api.anthropic.com/v1              (Claude — needs anthropic adapter)
#   https://chat.dartmouth.edu/api            (Dartmouth's hosted endpoint)
OPENAI_BASE_URL=https://api.portal.nousresearch.com/v1

# Which model the agent should use. Must be one the endpoint exposes.
# Nous Portal exposes the Hermes family + 300+ other models.
#   - Hermes-4-405B   (recommended; large, strong tool-use)
#   - Hermes-4-70B    (faster, smaller)
#   - Hermes-3-405B   (previous gen)
AGENT_MODEL=Hermes-4-405B

# ----------------------------------------------------------------------------
# Data
# ----------------------------------------------------------------------------
# Optional override of the HNOCA subset path. Default is data/hnoca_dt_subset.h5ad.
# HNOCA_DATA_PATH=data/hnoca_dt_subset.h5ad

# ----------------------------------------------------------------------------
# Tools
# ----------------------------------------------------------------------------
# Optional: NCBI E-utilities API key for higher PubMed rate limits.
# Without a key you get 3 req/s, which is fine for the benchmark.
# NCBI_API_KEY=...
