# Copy this file to `.env` and uncomment/edit the section you want.
# `.env` is gitignored.
#
#   cp .env.example .env
#
# Default backbone is LOCAL: Hermes-4-14B running through Ollama. Free, offline.
# To use a different backbone, comment out the LOCAL block and uncomment one of
# the alternatives below.

# ============================================================================
# DEFAULT — Local Hermes-4-14B via Ollama (free, no API key, ~9 GB on disk)
# ============================================================================
# Prereq one-time:
#   brew install ollama
#   brew services start ollama
#   ollama pull hf.co/bartowski/NousResearch_Hermes-4-14B-GGUF:Q4_K_M
#
# These three values are the defaults baked into organoid_agent/modules/
# agent_llms.py — uncomment only if you want to override them.
# OPENAI_API_KEY=ollama-local
# OPENAI_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=hf.co/bartowski/NousResearch_Hermes-4-14B-GGUF:Q4_K_M

# ============================================================================
# ALTERNATIVE 1 — Nous Portal (Hermes-4-405B; paid; best quality)
# ============================================================================
# Sign up at https://portal.nousresearch.com
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.portal.nousresearch.com/v1
# AGENT_MODEL=Hermes-4-405B

# ============================================================================
# ALTERNATIVE 2 — OpenAI (GPT-4o or GPT-4o-mini; paid; familiar)
# ============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o-mini

# ============================================================================
# ALTERNATIVE 3 — OpenRouter (any of 300+ models, including Hermes-4; paid)
# ============================================================================
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=nousresearch/hermes-4-405b

# ============================================================================
# Tools
# ============================================================================
# Optional NCBI E-utilities key for higher PubMed rate limits.
# Without a key you get 3 req/s, which is fine for the benchmark.
# NCBI_API_KEY=

# Optional override of the HNOCA subset path.
# HNOCA_DATA_PATH=data/hnoca_dt_subset.h5ad
